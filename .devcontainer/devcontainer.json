{
	"name": "familienhub",
	"build": { "dockerfile": "Dockerfile" },
	"features": {
		"ghcr.io/devcontainers/features/node:1": { "version": "24" },
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
	},
	"remoteUser": "vscode",
	"forwardPorts": [5173, 8090],
	"mounts": [
		"source=claude-code-config-${devcontainerId},target=/home/vscode/.claude,type=volume",
		"source=familienhub-node-modules-${devcontainerId},target=${containerWorkspaceFolder}/node_modules,type=volume"
	],
	"remoteEnv": {
		"GITHUB_PERSONAL_ACCESS_TOKEN": "${localEnv:GITHUB_PERSONAL_ACCESS_TOKEN}",
		"GH_TOKEN": "${localEnv:GITHUB_PERSONAL_ACCESS_TOKEN}",
		"ANTHROPIC_API_KEY": "${localEnv:ANTHROPIC_API_KEY}"
	},
	"postCreateCommand": "sudo chown vscode node_modules && corepack enable && pnpm install && pnpm exec playwright install --with-deps chromium && pnpm run pb:download && pnpm run doctor",
	"customizations": {
		"vscode": {
			"extensions": [
				"anthropic.claude-code",
				"svelte.svelte-vscode",
				"dbaeumer.vscode-eslint",
				"esbenp.prettier-vscode"
			]
		}
	}
}
