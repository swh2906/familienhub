{
	"mcpServers": {
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/",
			"headers": {
				"Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
				"X-MCP-Toolsets": "repos,issues,pull_requests,actions",
				"X-MCP-Readonly": "true"
			}
		},
		"code-graph": {
			"command": "npx",
			"args": ["-y", "@sdsrs/code-graph"]
		}
	}
}
